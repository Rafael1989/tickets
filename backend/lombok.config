config.stopBubbling = true

# Marks Lombok-generated members (equals/hashCode/canEqual, builders, getters)
# with @lombok.Generated, which JaCoCo honours and skips. Without this, the
# branch counter is dominated by generated equals/canEqual null-and-type
# checks nobody writes tests for, and real gaps hide behind that noise.
lombok.addLombokGeneratedAnnotation = true
