<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-08-02-10" author="ticketwave">
        <comment>
            Ledger entries: an append-only audit trail of every financial movement
            (payment, refund, fee adjustment) against a booking, backing the admin
            reconciliation report. amount is signed (positive in, negative out) so a
            date range's entries sum directly to net cash movement. payment_id/refund_id
            are nullable because not every entry originates from both — a PAYMENT entry
            has no refund_id, a REFUND entry always has both (it references the payment
            it's refunding).
        </comment>
        <createTable tableName="ledger_entries">
            <column name="ledger_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_ledger_entries"/>
            </column>
            <column name="booking_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_ledger_entries_booking"
                             references="bookings(booking_id)"/>
            </column>
            <column name="payment_id" type="BIGINT">
                <constraints nullable="true"
                             foreignKeyName="fk_ledger_entries_payment"
                             references="payments(payment_id)"/>
            </column>
            <column name="refund_id" type="BIGINT">
                <constraints nullable="true"
                             foreignKeyName="fk_ledger_entries_refund"
                             references="refunds(refund_id)"/>
            </column>
            <column name="entry_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="recorded_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
        </createTable>

        <sql dbms="postgresql">
            ALTER TABLE ledger_entries ADD CONSTRAINT ck_ledger_entries_entry_type
                CHECK (entry_type IN ('payment', 'refund', 'adjustment'));
        </sql>

        <createIndex tableName="ledger_entries" indexName="ix_ledger_entries_booking_id">
            <column name="booking_id"/>
        </createIndex>
        <createIndex tableName="ledger_entries" indexName="ix_ledger_entries_recorded_at">
            <column name="recorded_at"/>
        </createIndex>

        <rollback>
            <dropTable tableName="ledger_entries"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
