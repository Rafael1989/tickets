<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-08-02-05" author="ticketwave">
        <comment>
            Partner API credentials: OAuth2 client-credentials style
            machine-to-machine access for a partner's own systems.
            client_secret_hash is BCrypt, same as users.password_hash — the
            raw secret is only ever shown once, at issuance.
        </comment>
        <createTable tableName="partner_api_credentials">
            <column name="credential_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_partner_api_credentials"/>
            </column>
            <column name="partner_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_partner_api_credentials_partner"
                             references="partners(partner_id)"/>
            </column>
            <column name="client_id" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_partner_api_credentials_client_id"/>
            </column>
            <column name="client_secret_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_used_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="revoked_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

        <sql dbms="postgresql">
            ALTER TABLE partner_api_credentials ADD CONSTRAINT ck_partner_api_credentials_status
                CHECK (status IN ('active', 'revoked'));
        </sql>

        <createIndex tableName="partner_api_credentials" indexName="ix_partner_api_credentials_partner_id">
            <column name="partner_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="partner_api_credentials"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
