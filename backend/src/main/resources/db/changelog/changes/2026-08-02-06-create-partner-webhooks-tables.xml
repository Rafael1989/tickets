<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-08-02-06" author="ticketwave">
        <comment>
            Partner webhooks: outbound notification targets a partner
            registers per event type, plus an append-only delivery log
            (payload, response status, success) for every attempt — the
            tamper-evident trail confirming whether an event was actually
            sent and how the partner's endpoint responded.
        </comment>
        <createTable tableName="partner_webhooks">
            <column name="webhook_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_partner_webhooks"/>
            </column>
            <column name="partner_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_partner_webhooks_partner"
                             references="partners(partner_id)"/>
            </column>
            <column name="url" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="secret" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql dbms="postgresql">
            ALTER TABLE partner_webhooks ADD CONSTRAINT ck_partner_webhooks_status
                CHECK (status IN ('active', 'disabled'));
        </sql>

        <createIndex tableName="partner_webhooks" indexName="ix_partner_webhooks_partner_event">
            <column name="partner_id"/>
            <column name="event_type"/>
        </createIndex>

        <createTable tableName="webhook_delivery_logs">
            <column name="delivery_log_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_webhook_delivery_logs"/>
            </column>
            <column name="webhook_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_webhook_delivery_logs_webhook"
                             references="partner_webhooks(webhook_id)"/>
            </column>
            <column name="event_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="payload" type="VARCHAR(4000)">
                <constraints nullable="false"/>
            </column>
            <column name="response_status" type="INT"/>
            <column name="success" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="VARCHAR(500)"/>
            <column name="attempted_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="webhook_delivery_logs" indexName="ix_webhook_delivery_logs_webhook_id">
            <column name="webhook_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="webhook_delivery_logs"/>
            <dropTable tableName="partner_webhooks"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
