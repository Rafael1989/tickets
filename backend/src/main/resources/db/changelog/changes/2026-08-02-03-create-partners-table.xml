<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-08-02-03" author="ticketwave">
        <comment>
            Partners: a carrier/vendor company onboarded onto the platform.
            OPERATOR user accounts are linked to a partner (see the following
            changeset) so several staff logins under one company can share
            its route/vehicle/driver inventory.
        </comment>
        <createTable tableName="partners">
            <column name="partner_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_partners"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_partners_name"/>
            </column>
            <column name="contact_email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="commission_rate" type="DECIMAL(5,4)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql dbms="postgresql">
            ALTER TABLE partners ADD CONSTRAINT ck_partners_status
                CHECK (status IN ('pending', 'active', 'suspended'));
        </sql>

        <rollback>
            <dropTable tableName="partners"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
