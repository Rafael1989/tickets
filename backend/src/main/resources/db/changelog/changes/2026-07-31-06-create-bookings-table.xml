<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-07-31-06" author="ticketwave">
        <comment>Bookings: a customer's reservation against a schedule, identified by a unique PNR.</comment>
        <createTable tableName="bookings">
            <column name="booking_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_bookings"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_bookings_user"
                             references="users(user_id)"/>
            </column>
            <column name="schedule_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_bookings_schedule"
                             references="schedules(schedule_id)"/>
            </column>
            <column name="pnr" type="VARCHAR(10)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_bookings_pnr"/>
            </column>
            <column name="booking_time" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="initiated">
                <constraints nullable="false"/>
            </column>
            <column name="total_amount" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql dbms="postgresql">
            ALTER TABLE bookings ADD CONSTRAINT ck_bookings_status
                CHECK (status IN ('initiated', 'confirmed', 'cancelled'));
        </sql>

        <createIndex tableName="bookings" indexName="ix_bookings_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="bookings" indexName="ix_bookings_schedule_id">
            <column name="schedule_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="bookings"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
