<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-08-01-11" author="ticketwave">
        <comment>
            Fare rules: a seasonal per-route/seat-class fare adjustment, active
            over [valid_from, valid_to). Read by PricingServiceImpl alongside its
            existing demand-based multiplier - see calculateFareRuleAdjustment.
        </comment>
        <createTable tableName="fare_rules">
            <column name="fare_rule_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_fare_rules"/>
            </column>
            <column name="route_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_fare_rules_route"
                             references="routes(route_id)"/>
            </column>
            <column name="seat_class" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="valid_from" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="valid_to" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="surcharge_rate" type="DECIMAL(6,4)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="fare_rules" indexName="ix_fare_rules_route_seat_class">
            <column name="route_id"/>
            <column name="seat_class"/>
        </createIndex>

        <rollback>
            <dropTable tableName="fare_rules"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
