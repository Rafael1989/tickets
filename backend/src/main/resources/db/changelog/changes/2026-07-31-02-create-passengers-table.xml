<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-07-31-02" author="ticketwave">
        <comment>Passengers: travelers/attendees saved against a user account for reuse across bookings.</comment>
        <createTable tableName="passengers">
            <column name="passenger_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_passengers"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_passengers_user"
                             references="users(user_id)"/>
            </column>
            <column name="full_name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="dob" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="id_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="id_number" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="passengers" indexName="ix_passengers_user_id">
            <column name="user_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="passengers"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
